# Copied to backend/.env.local by `make setup`. Never commit .env.local.
TSG_APP_ENV=local
TSG_CLOUD=local
TSG_LOG_LEVEL=INFO
# console (readable, local) or json (cloud)
TSG_LOG_FORMAT=console

# Data store: mongo (local MongoDB via `make db`) or memory (lost on restart)
TSG_STORE=mongo
TSG_MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
TSG_MONGO_DATABASE=tsg_local

# Known clients (becomes the tenant catalog later)
TSG_TENANTS=acme,beta

# Sign-in: tokens are verified against this OIDC issuer (tools/dev-idp locally).
# A localhost issuer is refused unless TSG_APP_ENV is local or test.
TSG_OIDC_ISSUER=http://127.0.0.1:8081
TSG_OIDC_AUDIENCE=tsg-gateway
